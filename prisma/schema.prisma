datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Device {
  id        Int      @id @default(autoincrement())
  name      String
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("devices")
}

model Defibrillator {
  id        Int        @id @default(autoincrement())
  name      String
  status    String
  createdAt DateTime   @default(now()) @map("created_at")
  readings  Readings[]

  @@map("defibrillators")
}

model Readings {
  id              Int            @id @default(autoincrement())
  defibId         String         @map("defib_id")
  heartRateBpm    Float          @map("heart_rate_bpm")
  sdnnMs          Float          @map("sdnn_ms")
  rmssdMs         Float          @map("rmssd_ms")
  lfPower         Float          @map("lf_power")
  hfPower         Float          @map("hf_power")
  lfHfRatio       Float          @map("lf_hf_ratio")
  qrsWidthMs      Float          @map("qrs_width_ms")
  signalEntropy   Float          @map("signal_entropy")
  signalEnergy    Float          @map("signal_energy")
  createdAt       DateTime       @default(now()) @map("created_at")
  Defibrillator   Defibrillator? @relation(fields: [defibrillatorId], references: [id])
  defibrillatorId Int?

  @@map("readings")
}

model WebSocketConnection {
  id           String   @id @default(cuid())
  connectionId String   @unique @map("connection_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("web_socket_connections")
}
